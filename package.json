{
  "name": "livestock-management-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "nodemon --delay 1000ms server/src/server.js",
    "server": "nodemon --delay 1000ms server/src/server.js",
    "ganache": "ganache --deterministic --port 8545",
    "compile:contract": "solcjs --bin --abi contracts/AgriChainAnchor.sol -o contracts/build",
    "deploy:ganache": "node contracts/deploy.js",
    "deploy:sepolia": "npm run compile:contract && node contracts/deploy.js --sepolia"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "solc": "^0.8.30"
  }
}
